const {
  getAllServices,
  getServiceById,
} = require("../models/service");
const ApiError = require("../utils/apiError");
const ApiResponse = require("../utils/apiResponse");
const asyncHandler = require("../utils/asyncHandler");

// GET all services
const fetchAllServices = asyncHandler(async (req, res) => {
  const services = await getAllServices();
  res.json(new ApiResponse(200, services, "Services fetched successfully"));
});

// GET service by id
const fetchServiceById = asyncHandler(async (req, res) => {
  const { id } = req.params;
  const service = await getServiceById(id);

  if (!service) {
    throw new ApiError(404, "Service not found");
  }

  res.json(new ApiResponse(200, service, "Service fetched successfully"));
});

module.exports = {
  fetchAllServices,
  fetchServiceById,
};
